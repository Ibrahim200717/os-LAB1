#include <stdio.h>

int main() {
    int n, frames;
    printf("Enter number of pages: ");
    scanf("%d", &n);

    int pages[50];
    printf("Enter page reference string: ");
    for (int i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    int frame[10], time[10], faults = 0;
    for (int i = 0; i < frames; i++)
        frame[i] = -1;

    for (int i = 0; i < n; i++) {
        int found = -1;
        for (int j = 0; j < frames; j++)
            if (frame[j] == pages[i])
                found = j;

        if (found == -1) {
            int replace = 0;
            for (int j = 0; j < frames; j++) {
                if (frame[j] == -1) { replace = j; break; }
                if (time[j] < time[replace]) replace = j;
            }
            frame[replace] = pages[i];
            time[replace] = i;
            faults++;
        } else {
            time[found] = i;
        }

        printf("Page %d -> ", pages[i]);
        for (int j = 0; j < frames; j++)
            printf("%d ", frame[j]);
        printf("\n");
    }

    printf("Total page faults: %d\n", faults);
    return 0;
}
