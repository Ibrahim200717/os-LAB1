#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <stdio.h>

int main() {
    char name[20], newname[20];
    int choice;

    do {
        printf("\n1.Create 2.Rename 3.Delete 4.Exit\nEnter choice: ");
        scanf("%d", &choice);

        if (choice == 1) {
            printf("Enter file name: ");
            scanf("%s", name);
            int fd = creat(name, 0644);
            close(fd);
            printf("File created.\n");
        } else if (choice == 2) {
            printf("Enter old name and new name: ");
            scanf("%s %s", name, newname);
            rename(name, newname);
            printf("File renamed.\n");
        } else if (choice == 3) {
            printf("Enter file name to delete: ");
            scanf("%s", name);
            unlink(name);
            printf("File deleted.\n");
        }
    } while (choice != 4);

    return 0;
}
